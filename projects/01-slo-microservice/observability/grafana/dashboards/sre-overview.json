{
  "uid": "sre-overview",
  "title": "SRE Demo Service Overview",
  "tags": ["sre", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (http_status) (rate(http_requests_total[5m]))", "legendFormat": "{{http_status}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx ratio",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 9},
      "targets": [{"expr": "sum(rate(http_requests_total{http_status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}]
    }
  ]
}